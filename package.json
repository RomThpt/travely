{
  "name": "travely",
  "private": true,
  "version": "0.1.0",
  "description": "Multimodal travel tracking with live trips, local travel stamps, and delay alerts",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:mobile": "bun run --cwd apps/mobile start",
    "dev:proxy": "bun run --cwd apps/proxy dev",
    "dev:market": "bun run --cwd apps/market dev",
    "test": "bun run --filter '*' test",
    "typecheck": "bun run --filter '*' typecheck",
    "lint": "bun run --filter '*' lint",
    "check": "bun run typecheck && bun run lint && bun run test"
  },
  "packageManager": "bun@1.3.8"
}
