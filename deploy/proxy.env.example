# Required: shared secret for x-travely-key, min 16 characters. The server fails to
# boot without it.
PROXY_KEY=change-me-to-a-long-random-string

# Optional provider keys. Leave a line commented out (not set to an empty value) if you
# don't have that key yet: an empty string is not the same as unset, and the proxy fails
# closed on an empty optional value instead of treating it as missing.
# AERODATABOX_KEY=
AERODATABOX_HOST=aerodatabox.p.rapidapi.com
# SNCF_KEY=
# AISSTREAM_KEY=

PROXY_PORT=8787
RATE_LIMIT_PER_IP_PER_MIN=60

# Optional native passkey association on PROXY_DOMAIN.
# PASSKEY_RP_ID=proxy.example.com
# PASSKEY_APPLE_TEAM_ID=ABCDEFGHIJ
# PASSKEY_ANDROID_SHA256_FINGERPRINTS=AA:BB:... (32 SHA-256 bytes)
