# Copy provider settings to apps/proxy/.env. Never commit real values.
AERODATABOX_KEY=
AERODATABOX_HOST=aerodatabox.p.rapidapi.com
SNCF_KEY=
AISSTREAM_KEY=
PROXY_PORT=8787
# Required, at least 16 characters.
PROXY_KEY=
# Google OAuth Web client. Use http://localhost:8787/auth/google/callback for the iOS simulator;
# use the public HTTPS proxy URL plus /auth/google/callback for physical devices.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
# Public HTTPS hostname for native passkey association (same as mobile RP ID).
PASSKEY_RP_ID=
# Public app identifiers, not secrets. Set each platform when its signing identity is known.
PASSKEY_APPLE_TEAM_ID=
PASSKEY_ANDROID_SHA256_FINGERPRINTS=
# Private Enoki key enabled for Sponsored Transactions. Proxy only; never expose to Expo.
ENOKI_PRIVATE_API_KEY=
ENOKI_API_URL=https://api.enoki.mystenlabs.com/v1
SUI_RPC_URL=https://fullnode.testnet.sui.io:443
SUI_PACKAGE_ID=0x364922c3a44683eed8c1e05b5bf1b79d4c3a88ac2ad748b295740e4fb4e04da2
SUI_USDC_TYPE=0xa1ec7fc00a6f40db9693ad1415d0c193ad3906494428cf252621037bd7117e29::usdc::USDC
MAX_POSITION_USDC=100
