# Public settings bundled into the mobile app. Never put provider secrets here.
EXPO_PUBLIC_PROXY_URL=http://localhost:8787
EXPO_PUBLIC_PROXY_KEY=
# Enoki public API key enabled for zkLogin on Sui testnet.
EXPO_PUBLIC_ENOKI_PUBLIC_KEY=
# HTTPS domain that hosts passkey association files, without a scheme or port.
EXPO_PUBLIC_PASSKEY_RP_ID=
# Android clientDataJSON origins: android:apk-key-hash:<base64url SHA-256 signing-cert hash>.
# Separate debug/release origins with commas when needed.
EXPO_PUBLIC_PASSKEY_ANDROID_ORIGINS=
# Sui testnet contract. The default is in features/market/suiMarket.ts.
EXPO_PUBLIC_SUI_PACKAGE_ID=0x15b2b349eb5b7ef96ba76fe50db525134b99b86ff38986ad64ba71c879d9805a
